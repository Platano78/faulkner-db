{
  "mcpServers": {
    "faulkner-db": {
      "command": "/path/to/faulkner-db/venv/bin/python3",
      "args": [
        "/path/to/faulkner-db/mcp_server/server_fastmcp.py"
      ],
      "env": {
        "PYTHONPATH": "/path/to/faulkner-db:/path/to/faulkner-db/core:/path/to/faulkner-db/mcp_server"
      }
    }
  }
}
