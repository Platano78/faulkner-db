[Unit]
Description=Faulkner-DB Graph Health Check
Documentation=https://github.com/Platano78/faulkner-db
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/project/faulkner-db
# Wrapper sources docker/.env for credentials and forces FALKORDB_HOST
# to the actual host (the .env's 'falkordb' is docker-internal only).
# --strict would exit 1 on any warning, marking the unit failed.
# Leave it off for the periodic check so persistent warnings (e.g. high
# Pattern degree on the curated corpus) don't constantly flag failure.
# Run with --strict manually for ad-hoc gating:
#   ~/project/faulkner-db/scripts/run-health-check.sh --strict
ExecStart=%h/project/faulkner-db/scripts/run-health-check.sh
StandardOutput=journal
StandardError=journal

# Resource limits — health_check is read-only and small
MemoryMax=512M
CPUQuota=25%

[Install]
WantedBy=multi-user.target

# Install (user-level systemd):
#
#   mkdir -p ~/.config/systemd/user
#   cp scripts/faulkner-health-graph.service ~/.config/systemd/user/
#   cp scripts/faulkner-health-graph.timer   ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now faulkner-health-graph.timer
#
# Verify:
#   systemctl --user status faulkner-health-graph.timer
#   journalctl --user -u faulkner-health-graph.service -n 50
#
# Manual run:
#   systemctl --user start faulkner-health-graph.service
#
# EnvironmentFile loads FALKORDB_HOST/PORT/PASSWORD from docker/.env so
# the same credentials work for both the docker-compose stack and this
# scheduled job.
